# Optional live-model configuration. Core unit tests should pass without these.

# Auth — CI_TOKEN (preferred) or OPENAI_API_KEY
CI_TOKEN=
OPENAI_API_KEY=

# LLM proxy endpoint (leave blank to use api.openai.com)
OPENAI_BASE_URL=

# Optional custom request header sent to the LLM endpoint
# Set both to add the header; leave blank to omit it
LLM_APP_HEADER_NAME=
LLM_APP_HEADER_VALUE=

# Models
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=

# Optional A/B baseline model comparison.
# Provide two or more comma-separated chat model names to compare live tool-calling variants.
# Example: AGENT_AB_MODELS=gpt-4o-mini,gpt-4.1-mini
AGENT_AB_MODELS=

# Legacy / other providers
ANTHROPIC_API_KEY=
RUN_LIVE_TESTS=0
